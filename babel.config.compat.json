{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": { "node": "10" },
        "modules": "cjs"
      }
    ]
  ],
  "plugins": [
    [
      "babel-plugin-transform-rewrite-imports",
      {
        "replaceExtensions": {
          ".js": ".cjs"
        },
        "injectDynamicRewriter": "never"
      }
    ]
  ],
  "comments": false
}
