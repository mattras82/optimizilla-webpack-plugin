{
  "presets": [
    ["@babel/preset-env", {
      "targets": { "node": "14.18" },
      "modules": false
    }]
  ],
  "plugins": [
    [
      "babel-plugin-transform-rewrite-imports",
      {
        "replaceExtensions": {
          ".js": ".mjs"
        },
        "injectDynamicRewriter": "never"
      }
    ]
  ],
  "comments": false
}
